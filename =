from langchain_groq import ChatGroq
import os


# -----------------------------
# LLM Initialization (SAFE)
# -----------------------------
def get_llm():
    try:
        api_key = os.getenv("GROQ_API_KEY")
        if not api_key:
            raise ValueError("Missing GROQ_API_KEY")

        # ✅ Updated working model (old one deprecated)
        return ChatGroq(
            model="llama3-70b-8192",
            temperature=0
        )

    except Exception as e:
        print("LLM init error:", e)
        return None


# -----------------------------
# Planner Agent
# -----------------------------
def planner_agent(state):
    try:
        llm = get_llm()

        if not llm:
            return {**state, "plan": "LLM not available"}

        user_input = state.get("input", "")

        if not user_input:
            return {**state, "plan": "No input provided"}

        prompt = f"""
You are a senior AI system planner.

Break down the following task into clear step-by-step plan:

Task: {user_input}

Return only steps.
"""

        response = llm.invoke(prompt)

        return {
            **state,
            "plan": response.content.strip()
        }

    except Exception as e:
        print("Planner error:", e)
        return {
            **state,
            "plan": f"Error: {str(e)}"
        }


